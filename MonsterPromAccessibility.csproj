<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Folder that contains the game's .exe. Override with -p:GameDir="..." -->
    <GameDir Condition="'$(GameDir)' == ''">C:\Program Files (x86)\Steam\steamapps\common\Monster Prom</GameDir>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net46</TargetFramework>
    <AssemblyName>MonsterPromAccessibility</AssemblyName>
    <RootNamespace>MonsterPromAccessibility</RootNamespace>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="BepInEx">
      <HintPath>$(GameDir)\BepInEx\core\BepInEx.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="0Harmony">
      <HintPath>$(GameDir)\BepInEx\core\0Harmony.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="UnityEngine">
      <HintPath>$(GameDir)\MonsterProm_Data\Managed\UnityEngine.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="UnityEngine.CoreModule">
      <HintPath>$(GameDir)\MonsterProm_Data\Managed\UnityEngine.CoreModule.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp">
      <HintPath>$(GameDir)\MonsterProm_Data\Managed\Assembly-CSharp.dll</HintPath>
      <Private>false</Private>
    </Reference>
    <Reference Include="Assembly-CSharp-firstpass">
      <HintPath>$(GameDir)\MonsterProm_Data\Managed\Assembly-CSharp-firstpass.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>

  <!-- Local decompiled game code for reference only; never compiled or committed. -->
  <ItemGroup>
    <Compile Remove="decompiled\**\*.cs" />
    <None Remove="decompiled\**\*" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Prism\prism.dll" Link="prism.dll" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Prism\LICENSE;Prism\NOTICE" Link="Prism\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
    <None Include="Prism\LICENSES\**\*" Link="Prism\LICENSES\%(RecursiveDir)%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>


</Project>
